def forward(self, W_1, x_1, t_1, n_1):
    w_1 = W_1
    mm = torch.ops.aten.mm.default(x_1, w_1);  w_1 = None
    sub = torch.ops.aten.sub.Tensor(mm, t_1);  mm = t_1 = None
    pow_1 = torch.ops.aten.pow.Tensor_Scalar(sub, 2)
    sum_1 = torch.ops.aten.sum.default(pow_1);  pow_1 = None
    div = torch.ops.aten.div.Tensor(sum_1, n_1);  sum_1 = None
    ones_like = torch.ops.aten.ones_like.default(div, pin_memory = False, memory_format = torch.preserve_format)
    div_1 = torch.ops.aten.div.Tensor(ones_like, n_1);  ones_like = n_1 = None
    expand = torch.ops.aten.expand.default(div_1, [1, 1]);  div_1 = None
    pow_2 = torch.ops.aten.pow.Tensor_Scalar(sub, 1.0);  sub = None
    mul = torch.ops.aten.mul.Scalar(pow_2, 2.0);  pow_2 = None
    mul_1 = torch.ops.aten.mul.Tensor(expand, mul);  expand = mul = None
    t = torch.ops.aten.t.default(x_1);  x_1 = None
    mm_1 = torch.ops.aten.mm.default(t, mul_1);  t = mul_1 = None
    return [div, mm_1]
    
